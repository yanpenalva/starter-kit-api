APP_NAME="Starter Kit API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
HTTP_PORT=8080

LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=starter_api_dev
DB_USERNAME=starter_api_dev
DB_PASSWORD=
TEST_DB_DATABASE=starter_api_test
TEST_DB_USERNAME=starter_api_test
TEST_DB_PASSWORD=

SESSION_DRIVER=file
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
QUEUE_AFTER_COMMIT=false
REDIS_QUEUE=default

REDIS_HOST=redis
REDIS_PORT=6379
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME="Starter Kit API"

# Mailpit HTTP API base used ONLY by dev/test smoke verification code that
# peeks the synthetic inbox (config: mail.infra_smoke.mailpit_api_url). It is
# never used by application mail delivery. Default (documented in
# config/mail.php): http://mailpit-test:8025 — the internal test service name
# on the `testing` network; it does not resolve on the host. The dev async
# stack exposes Mailpit on 127.0.0.1:${MAILPIT_PORT} instead. Override only if
# you relocate Mailpit; an unset value keeps the built-in default.
#MAILPIT_API_URL=http://mailpit-test:8025
