APP_NAME="Starter Kit API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
HTTP_PORT=8080

LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=starter_api_dev
DB_USERNAME=starter_api_dev
DB_PASSWORD=
TEST_DB_DATABASE=starter_api_test
TEST_DB_USERNAME=starter_api_test
TEST_DB_PASSWORD=

SESSION_DRIVER=file
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
QUEUE_AFTER_COMMIT=false
REDIS_QUEUE=default

REDIS_HOST=redis
REDIS_PORT=6379
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME="Starter Kit API"
