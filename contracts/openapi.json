{
    "openapi": "3.1.0",
    "info": {
        "title": "Starter Kit API",
        "version": "1.0.0",
        "description": "Starter Kit API v1: Sanctum session authentication for the first-party SPA."
    },
    "servers": [
        {
            "url": "/"
        }
    ],
    "paths": {
        "/api/v1": {
            "get": {
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "ok"
                                        }
                                    },
                                    "required": [
                                        "status"
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/api/v1/login": {
            "post": {
                "operationId": "auth.login",
                "tags": [
                    "Login"
                ],
                "parameters": [
                    {
                        "name": "X-XSRF-TOKEN",
                        "in": "header",
                        "required": true,
                        "description": "Token XSRF espelhando o cookie XSRF-TOKEN; obrigat\u00f3rio em requisi\u00e7\u00f5es que alteram estado.",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "description": "An error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Error overview.",
                                            "examples": [
                                                "Invalid credentials."
                                            ]
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "An error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Error overview.",
                                            "examples": [
                                                "This account has been deactivated."
                                            ]
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    },
                    "419": {
                        "description": "Token CSRF ausente ou inv\u00e1lido.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "examples": [
                                                "CSRF token mismatch."
                                            ]
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Limite de requisi\u00e7\u00f5es excedido.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "examples": [
                                                "Too many requests."
                                            ]
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        },
                        "headers": {
                            "Retry-After": {
                                "description": "Segundos at\u00e9 que o cliente possa tentar novamente.",
                                "schema": {
                                    "type": "integer"
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/api/v1/logout": {
            "post": {
                "operationId": "auth.logout",
                "tags": [
                    "Logout"
                ],
                "parameters": [
                    {
                        "name": "X-XSRF-TOKEN",
                        "in": "header",
                        "required": true,
                        "description": "Token XSRF espelhando o cookie XSRF-TOKEN; obrigat\u00f3rio em requisi\u00e7\u00f5es que alteram estado.",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "419": {
                        "description": "Token CSRF ausente ou inv\u00e1lido.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "examples": [
                                                "CSRF token mismatch."
                                            ]
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Limite de requisi\u00e7\u00f5es excedido.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "examples": [
                                                "Too many requests."
                                            ]
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        },
                        "headers": {
                            "Retry-After": {
                                "description": "Segundos at\u00e9 que o cliente possa tentar novamente.",
                                "schema": {
                                    "type": "integer"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sessionCookie": []
                    }
                ]
            }
        },
        "/api/v1/auth/my-profile": {
            "get": {
                "operationId": "auth.myProfile",
                "tags": [
                    "MyProfile"
                ],
                "responses": {
                    "200": {
                        "description": "`MyProfileResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/MyProfileResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "403": {
                        "description": "Autenticado, mas explicitamente bloqueado (conta desativada).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "examples": [
                                                "This account has been deactivated."
                                            ]
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Limite de requisi\u00e7\u00f5es excedido.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "examples": [
                                                "Too many requests."
                                            ]
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        },
                        "headers": {
                            "Retry-After": {
                                "description": "Segundos at\u00e9 que o cliente possa tentar novamente.",
                                "schema": {
                                    "type": "integer"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sessionCookie": []
                    }
                ]
            }
        },
        "/sanctum/csrf-cookie": {
            "get": {
                "operationId": "sanctum.csrfCookie",
                "description": "Emite o cookie XSRF-TOKEN e o cookie de sess\u00e3o HttpOnly (starter-kit-api-session) para a SPA. P\u00fablico; nenhuma autentica\u00e7\u00e3o necess\u00e1ria.",
                "tags": [
                    "CSRF"
                ],
                "responses": {
                    "204": {
                        "description": "Sem conte\u00fado; cookies emitidos atrav\u00e9s dos cabe\u00e7alhos Set-Cookie."
                    }
                },
                "security": []
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sessionCookie": {
                "type": "apiKey",
                "description": "Cookie de sess\u00e3o stateful do Sanctum (HttpOnly, SameSite=lax). Apenas SPA prim\u00e1ria; sem fallback para Bearer ou PAT.",
                "in": "cookie",
                "name": "starter-kit-api-session"
            },
            "xsrfToken": {
                "type": "apiKey",
                "description": "Cabe\u00e7alho do token XSRF obrigat\u00f3rio em requisi\u00e7\u00f5es que alteram estado; o valor espelha o cookie XSRF-TOKEN emitido pelo endpoint CSRF.",
                "in": "header",
                "name": "X-XSRF-TOKEN"
            }
        },
        "schemas": {
            "LoginRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "password": {
                        "type": "string"
                    }
                },
                "required": [
                    "email",
                    "password"
                ],
                "title": "LoginRequest"
            },
            "MyProfileResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "email_verified_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "roles": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "permissions": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "id",
                    "name",
                    "email",
                    "email_verified_at",
                    "roles",
                    "permissions"
                ],
                "title": "MyProfileResource"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}