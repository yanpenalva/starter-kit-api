<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php" colors="true" cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <!-- PostgreSQL triggers and advisory locks are not implemented by SQLite. -->
            <exclude>tests/Feature/Actions/PrivilegeMutationPostgresRaceTest.php</exclude>
            <!-- Unique-constraint race behavior depends on PostgreSQL's concurrent transactions. -->
            <exclude>tests/Feature/Auth/EmailUniquenessConstraintTest.php</exclude>
            <!-- Concurrent index enforcement and schema triggers are PostgreSQL-specific. -->
            <exclude>tests/Feature/UserSchemaTest.php</exclude>
            <!-- This test intentionally requires its PostgreSQL-only database safety guard. -->
            <exclude>tests/Feature/Docs/ApiDocsAccessTest.php</exclude>
        </testsuite>
    </testsuites>
    <source><include><directory>app</directory></include></source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_DEBUG" value="false" force="true"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_USERNAME" value="starter_api_test" force="true"/>
        <!-- Real Redis/worker and Mailpit integration tests use the same service endpoints as CI. -->
        <env name="REDIS_HOST" value="127.0.0.1" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="QUEUE_AFTER_COMMIT" value="true" force="true"/>
        <env name="REDIS_QUEUE" value="testqueue" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="MAIL_HOST" value="127.0.0.1" force="true"/>
        <env name="MAIL_PORT" value="1025" force="true"/>
        <env name="MAILPIT_API_URL" value="http://127.0.0.1:8025" force="true"/>
    </php>
</phpunit>
